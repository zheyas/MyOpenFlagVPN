# Copy to .env (gitignored) or export inline.

# Transport: cupsonline (no account, recommended) | direct | yandex | vyandex | boards | mailru | oneme
TRANSPORT=cupsonline

# Role: client | exit-node
ROLE=client

# Shared AES-256-GCM secret. The SAME value must be set on the client and the
# exit so both derive identical keys. Generate one with: openssl rand -hex 32
ENCRYPTION_KEY=

# cupsonline: base64 room list from the exit (or leave empty and use ROOMS_URL).
# yandex / vyandex / boards: shared public document URL. mailru: public weblink.
# (URL is accepted as a backward-compatible alias for DOC_URL.)
DOC_URL=

# oneme (MAX): web token + the OTHER side's uid (client dials the exit's uid).
MAX_TOKEN=
MAX_UID=

# Client only: SOCKS5 listen address.
SOCKS5_LISTEN=:1080

# 1 enables verbose logging.
DEBUG=0

# cupsonline: exit /rooms endpoint. run-client.sh fetches DOC_URL from here so
# you never copy it by hand, e.g. https://<app>.onrender.com/rooms
ROOMS_URL=
